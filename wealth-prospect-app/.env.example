# Prospect Lens configuration. Copy to .env (or export) — every value is optional.

APP_NAME="Prospect Lens"

# SQLite by default. Swap for Postgres when you go multi-user:
#   postgresql+psycopg://user:pass@host:5432/prospect_lens
# DATABASE_URL=sqlite:///./data/prospects.db

# false = connectors return deterministic synthetic signals (offline demo mode).
# true  = enrichment calls SEC EDGAR full-text search, FEC and OpenCorporates.
LIVE_CONNECTORS=false

# Free key from https://api.open.fec.gov/developers/ (DEMO_KEY works at low volume)
FEC_API_KEY=DEMO_KEY
# SEC requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT="Prospect Lens you@example.com"

# Seed a synthetic demo book on first start (only when the prospects table is empty).
SEED_ON_STARTUP=true
SEED_COUNT=240
SEED_RANDOM_SEED=20260904
